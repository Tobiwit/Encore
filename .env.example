# Copy to .env.local for local development. Never commit real values.

# Public URL of the app (used for OAuth redirects and invite links). Spotify requires
# loopback IPs, not "localhost", for local redirect URIs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase — `pnpm exec supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: used by background jobs and narrowly scoped server code.
SUPABASE_SECRET_KEY=

# Spotify app (https://developer.spotify.com/dashboard). Read by supabase/config.toml for
# sign-in and by the server for token refresh. Redirect URI to register in Spotify:
#   local:  http://127.0.0.1:54321/auth/v1/callback
#   hosted: https://<project-ref>.supabase.co/auth/v1/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts provider tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Ticketmaster Discovery API (https://developer.ticketmaster.com/). Optional: without it,
# event discovery jobs are skipped.
TICKETMASTER_API_KEY=
# Comma-separated ISO country codes to search.
TICKETMASTER_COUNTRY_CODES=DE,AT,CH

# Shared secret for /api/cron/* (hosted schedulers send "Authorization: Bearer <secret>").
CRON_SECRET=

# Web Push (optional). Generate with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
