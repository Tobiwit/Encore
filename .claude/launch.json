{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "encore-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "encore-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "start",
        "-p",
        "3001",
        "-H",
        "127.0.0.1"
      ],
      "port": 3001,
      "url": "http://127.0.0.1:3001"
    }
  ]
}
